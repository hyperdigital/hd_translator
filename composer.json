{
  "name": "hyperdigital/hd_translator",
  "type": "typo3-cms-extension",
  "description": "Translation of static strings from locallang.xlf files and export/import of database related content",
  "authors": [
    {
      "name": "hyperdigital.de",
      "email": "developer@hyperdigital.de",
      "homepage": "https://www.hyperdigital.de/",
      "role": "Developer"
    },
    {
      "name": "coma.de",
      "email": "info@coma.de",
      "homepage": "https://www.coma.de/",
      "role": "Developer"
    }
  ],
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2 <8.99",
    "typo3/cms-core": ">=14.0 <14.99",
    "phpoffice/phpspreadsheet": "5.*",
    "symfony/translation": "^7.0 || ^8.0",
    "symfony/yaml": "^7.0 || ^8.0"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "hd_translator"
    }
  },
  "autoload": {
    "psr-4": {
      "Hyperdigital\\HdTranslator\\": "Classes/"
    }
  },
  "suggest": {
    "typo3/cms-extensionmanager": "Needed for the \"Synchronize all locallang.xlf files\" feature"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.5",
    "typo3/testing-framework": "^9.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Hyperdigital\\HdTranslator\\Tests\\": "Tests/"
    }
  },
  "scripts": {
    "test:unit": "phpunit -c Build/phpunit/UnitTests.xml",
    "test:phpstan": "phpstan analyse --no-progress",
    "test": [
      "@test:phpstan",
      "@test:unit"
    ]
  },
  "config": {
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true,
      "php-http/discovery": true
    }
  }
}
