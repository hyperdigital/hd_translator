; EditorConfig, see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json,xlf,xml}]
indent_size = 2

[*.html]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[composer.json]
indent_size = 4
