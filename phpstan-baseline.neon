parameters:
	ignoreErrors:
		-
			message: '#^If condition is always true\.$#'
			identifier: if.alwaysTrue
			count: 4
			path: Classes/Controller/Be/TranslatorController.php

		-
			message: '#^Variable \$keyArray in empty\(\) always exists and is not falsy\.$#'
			identifier: empty.variable
			count: 1
			path: Classes/Controller/Be/TranslatorController.php

		-
			message: '#^Left side of && is always true\.$#'
			identifier: booleanAnd.leftAlwaysTrue
			count: 1
			path: Classes/Hooks/DocHeaderButtonsHook.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: Classes/Services/DatabaseEntriesService.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 1
			path: Classes/Services/DatabaseEntriesService.php

		-
			message: '#^Left side of && is always true\.$#'
			identifier: booleanAnd.leftAlwaysTrue
			count: 1
			path: Classes/Services/DatabaseEntriesService.php

		-
			message: '#^Strict comparison using \=\=\= between mixed and null will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: Classes/Services/DatabaseEntriesService.php

		-
			message: '#^Variable \$field on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: Classes/Services/DatabaseEntriesService.php

		-
			message: '#^Variable \$langaugeField in empty\(\) always exists and is not falsy\.$#'
			identifier: empty.variable
			count: 4
			path: Classes/Services/DatabaseEntriesService.php

		-
			message: '#^Variable \$parentUidField in empty\(\) always exists and is not falsy\.$#'
			identifier: empty.variable
			count: 2
			path: Classes/Services/DatabaseEntriesService.php

		-
			message: '#^Variable \$value on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: Classes/Services/DatabaseEntriesService.php

		-
			message: '#^Variable \$where in empty\(\) always exists and is not falsy\.$#'
			identifier: empty.variable
			count: 2
			path: Classes/Services/DatabaseEntriesService.php
